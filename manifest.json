{
  "manifest_version": 3,
  "name": "GitLab Issue/MR Number Pin",
  "version": "1.0.0",
  "description": "Keep the current GitLab Issue or Merge Request number visible while scrolling.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/parser.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
